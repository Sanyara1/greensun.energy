# Copy into ~/.config/gsun-pr/runtime.env with mode 0600; never commit real values.
GSUN_PUBLISH_ENABLED=no
GSUN_GENERATE_ENABLED=no
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
# Full chat-completions endpoint for a provider selected by owner.
# Use loopback for local model, HTTPS for remote; no invented model name.
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional separate reviewing model; otherwise a separate call to LLM.
REVIEW_URL=
REVIEW_MODEL=
REVIEW_API_KEY=

# Same secret on bridge and Worker; generate locally, never paste into chat.
GSUN_PR_BRIDGE_TOKEN=
